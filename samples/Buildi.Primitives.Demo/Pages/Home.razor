@page "/"

@using Buildi.Primitives
@using Buildi.Primitives.TextScanning
@using Buildi.Primitives.Contact
@using Buildi.Primitives.Web
@using Buildi.Primitives.Person
@using Buildi.Primitives.Organization
@using Buildi.Primitives.Banking
@using Buildi.Primitives.Vehicle
@using Buildi.Primitives.Property
@using Buildi.Primitives.Product
@using Buildi.Primitives.Geography
@using Buildi.Primitives.Finance
@using Buildi.Primitives.Measurement
@using System.Text
@using System.Text.RegularExpressions
@using System.Text.Json
@using System.Net
@using Microsoft.JSInterop
@inject IJSRuntime JS

<PageTitle>Buildi.Primitives Demo</PageTitle>

<HeadContent>
    <style>
        mark.scan-match { padding: 2px 4px; border-radius: 3px; cursor: help; }
        .cat-personal { background-color: #f8d7da; border-bottom: 2px solid #dc3545; }
        .cat-org { background-color: #cfe2ff; border-bottom: 2px solid #0d6efd; }
        .cat-financial { background-color: #d1e7dd; border-bottom: 2px solid #198754; }
        .cat-contact { background-color: #cff4fc; border-bottom: 2px solid #0dcaf0; }
        .cat-vehicle { background-color: #fff3cd; border-bottom: 2px solid #ffc107; }
        .cat-property { background-color: #e2e3e5; border-bottom: 2px solid #6c757d; }
        .cat-product { background-color: #f5e6ff; border-bottom: 2px solid #6f42c1; }
        .cat-geography { background-color: #d1f2eb; border-bottom: 2px solid #20c997; }
        .cat-measurement { background-color: #fff0e6; border-bottom: 2px solid #fd7e14; }

        .scan-tip-wrap { position: relative; display: inline; }
        .scan-tip {
            display: none;
            position: absolute;
            bottom: calc(100% + 10px);
            left: 50%;
            transform: translateX(-50%);
            z-index: 100;
            background: var(--bs-body-bg, #fff);
            color: var(--bs-body-color, #212529);
            border: 1px solid var(--bs-border-color, #dee2e6);
            border-radius: 8px;
            padding: 10px 14px;
            box-shadow: 0 4px 12px rgba(0,0,0,.15);
            white-space: nowrap;
            font-family: var(--bs-body-font-family);
            font-size: 0.8rem;
            line-height: 1.5;
        }
        .scan-tip::after {
            content: '';
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            border: 7px solid transparent;
            border-top-color: var(--bs-border-color, #dee2e6);
        }
        .scan-tip::before {
            content: '';
            position: absolute;
            top: 100%;
            left: 50%;
            transform: translateX(-50%);
            border: 6px solid transparent;
            border-top-color: var(--bs-body-bg, #fff);
            z-index: 1;
            margin-top: -1px;
        }
        .scan-tip-wrap:hover .scan-tip { display: block; }
        .scan-tip-row { display: flex; gap: 6px; }
        .scan-tip-label { color: var(--bs-secondary-color); min-width: 75px; }
        .scan-tip-value { font-family: var(--bs-font-monospace); }

        .scan-tip-wrap.tip-left .scan-tip { left: 0; transform: none; }
        .scan-tip-wrap.tip-left .scan-tip::after,
        .scan-tip-wrap.tip-left .scan-tip::before { left: 18px; transform: none; }
        .scan-tip-source { display: block; }
        .scan-tip-source a { color: var(--bs-link-color); text-decoration: none; word-break: break-all; }
        .scan-tip-source a:hover { text-decoration: underline; }

        .scan-lookup { text-decoration: underline; text-decoration-style: dashed; }
        .scan-lookup:hover { text-decoration-style: solid; }
    </style>
</HeadContent>

<div class="container-fluid py-4 px-4">

    <div class="mb-4">
        <h1 class="display-6 fw-bold">Buildi.Primitives</h1>
        <p class="lead text-body-secondary">
            .NET library for validating, normalizing, and scanning Swedish domain data.
        </p>
    </div>

    @* ───────── Text Scanner ───────── *@
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Text Scanner</h5>
        </div>
        <div class="card-body">
            <p class="text-body-secondary small mb-2">
                Paste text containing Swedish identifiers &mdash; the scanner detects organisation numbers,
                personal identity numbers, phone numbers, emails, IBANs, and 20+ other types.
            </p>

            <div class="row g-2 mb-2">
                <div class="col">
                    <textarea class="form-control font-monospace" rows="10"
                              @bind="inputText" @bind:event="oninput" @bind:after="Scan"
                              placeholder="Paste or type text here..."></textarea>
                </div>
                <div class="col-auto d-flex flex-column gap-2">
                    <span class="text-body-secondary small">Load example:</span>
                    @foreach (var (name, text) in SampleTexts)
                    {
                        var t = text;
                        <button class="btn btn-outline-secondary btn-sm text-start"
                                @onclick="() => LoadExample(t)">@name</button>
                    }
                </div>
            </div>

            <div class="d-flex flex-wrap gap-3 align-items-center mb-3">
                <div class="btn-group" role="group">
                    <button type="button"
                            class="btn btn-sm @(displayMode == "label" ? "btn-primary" : "btn-outline-primary")"
                            @onclick="SetModeLabel">Label</button>
                    <button type="button"
                            class="btn btn-sm @(displayMode == "mask" ? "btn-primary" : "btn-outline-primary")"
                            @onclick="SetModeMask">Mask</button>
                    <button type="button"
                            class="btn btn-sm @(displayMode == "redact" ? "btn-primary" : "btn-outline-primary")"
                            @onclick="SetModeRedact">Redact</button>
                    <button type="button"
                            class="btn btn-sm @(displayMode == "lookup" ? "btn-primary" : "btn-outline-primary")"
                            @onclick="SetModeLookup">Lookup</button>
                </div>

                <select class="form-select form-select-sm w-auto" @bind="minimumConfidence" @bind:after="Scan">
                    @foreach (var conf in Enum.GetValues<TextMatchConfidence>())
                    {
                        <option value="@conf">Min: @conf</option>
                    }
                </select>
            </div>

            @if (scanResult != null && scannedText != null)
            {
                @if (scanResult.ResolvedCandidates.Count > 0)
                {
                    <div class="mb-2 d-flex flex-wrap gap-1 align-items-center">
                        @foreach (var cat in Enum.GetValues<TextCandidateCategory>())
                        {
                            var count = scanResult.ResolvedCandidates.Count(c => c.Category == cat);
                            if (count > 0)
                            {
                                <span class="badge @GetCategoryBadgeClass(cat)">@cat (@count)</span>
                            }
                        }
                        <span class="text-body-secondary small ms-2">
                            @scanResult.ResolvedCandidates.Count total
                        </span>
                    </div>
                }
                else
                {
                    <div class="alert alert-info small py-2 mb-2">No candidates found.</div>
                }

                <div class="p-3 bg-body-tertiary rounded border"
                     style="white-space: pre-wrap; font-family: var(--bs-font-monospace); font-size: 0.85rem; line-height: 1.7;">
                    @if (displayMode == "label")
                    {
                        @BuildLabeledHtml()
                    }
                    else if (displayMode == "mask")
                    {
                        @scanResult.MaskAll(scannedText)
                    }
                    else if (displayMode == "lookup")
                    {
                        @BuildLookupHtml()
                    }
                    else
                    {
                        @scanResult.RedactAll(scannedText)
                    }
                </div>

                @if (scanResult.ResolvedCandidates.Count > 0)
                {
                    <details class="mt-3">
                        <summary class="btn btn-link btn-sm p-0 text-decoration-none">
                            Show all @scanResult.ResolvedCandidates.Count candidates
                        </summary>
                        <div class="table-responsive mt-2">
                            <table class="table table-sm table-striped align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Original</th>
                                        <th>Type</th>
                                        <th>Category</th>
                                        <th>Confidence</th>
                                        <th>Formatted</th>
                                        <th>Normalized</th>
                                        <th>Masked</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var c in scanResult.ResolvedCandidates)
                                    {
                                        <tr>
                                            <td><code>@c.OriginalText</code></td>
                                            <td class="small">@c.TypeName</td>
                                            <td><span class="badge @GetCategoryBadgeClass(c.Category)">@c.Category</span></td>
                                            <td><span class="badge @GetConfidenceBadge(c.Confidence)">@c.Confidence</span></td>
                                            <td><code>@c.FormattedForm</code></td>
                                            <td><code>@c.NormalizedForm</code></td>
                                            <td><code>@c.MaskedForm</code></td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </details>
                }
            }
        </div>
    </div>

    <hr class="my-4" />

    @* ───────── Type Explorer ───────── *@
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Type Explorer</h5>
        </div>
        <div class="card-body">
            <p class="text-body-secondary small mb-3">
                All supported types with sample data. Edit any input to see live validation results.
            </p>

            @foreach (var group in TypeRegistry.Select((t, i) => (Type: t, Index: i)).GroupBy(x => x.Type.Category))
            {
                <h6 class="mt-3 mb-2 text-body-secondary border-bottom pb-1">@group.Key</h6>
                <div class="table-responsive">
                    <table class="table table-sm align-middle mb-2" style="font-size: 0.82rem;">
                        <thead>
                            <tr class="text-body-secondary">
                                <th style="width: 180px;">Type</th>
                                <th style="width: 240px;">Input</th>
                                <th style="width: 44px;" class="text-center">Valid</th>
                                <th>Format()</th>
                                <th>Normalize()</th>
                                <th>Masked</th>
                                <th>Natural</th>
                                <th>Properties</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (ti, idx) in group)
                            {
                                var input = typeInputs[idx];
                                var hasInput = !string.IsNullOrEmpty(input);
                                var isValid = hasInput && ti.IsValidFn(input);
                                <tr>
                                    <td class="fw-medium text-nowrap">
                                        @if (ti.TypeMeta is { } m)
                                        {
                                            <span class="scan-tip-wrap tip-left" style="cursor: help;">
                                                @m.Emoji @ti.Name
                                                <span class="scan-tip">
                                                    <div class="fw-bold mb-1">@m.EnglishName / @m.LocalizedName</div>
                                                    @if (m.Sources.Count > 0)
                                                    {
                                                        <div class="scan-tip-row mb-1">
                                                            <span class="scan-tip-label">Sources</span>
                                                        </div>
                                                        @foreach (var url in m.Sources)
                                                        {
                                                            <span class="scan-tip-source">
                                                                <a href="@url" target="_blank" rel="noopener">@(new Uri(url).Host)</a>
                                                            </span>
                                                        }
                                                    }
                                                </span>
                                            </span>
                                        }
                                        else
                                        {
                                            @ti.Name
                                        }
                                    </td>
                                    <td>
                                        <input type="text" class="form-control form-control-sm font-monospace py-0"
                                               style="font-size: 0.78rem;"
                                               value="@typeInputs[idx]"
                                               @oninput="e => typeInputs[idx] = e.Value?.ToString() ?? string.Empty" />
                                    </td>
                                    <td class="text-center">
                                        @if (!hasInput)
                                        { <span class="text-body-tertiary">&mdash;</span> }
                                        else if (isValid)
                                        { <span class="text-success fw-bold">&#x2713;</span> }
                                        else
                                        { <span class="text-danger">&#x2717;</span> }
                                    </td>
                                    <td><code class="small text-break">@(hasInput ? ti.FormatFn(input) ?? "\u2014" : "\u2014")</code></td>
                                    <td><code class="small text-break">@(hasInput ? ti.NormalizeFn(input) ?? "\u2014" : "\u2014")</code></td>
                                    <td><code class="small text-break">@(isValid ? ti.MaskedFn(input!) ?? "\u2014" : "\u2014")</code></td>
                                    <td><code class="small text-break">@(isValid && ti.NaturalFn is not null ? ti.NaturalFn(input!) ?? "\u2014" : "\u2014")</code></td>
                                    <td>
                                        @if (hasInput && ti.VariantsFn?.Invoke(input) is { Count: > 0 } variants)
                                        {
                                            <div class="d-flex flex-column gap-1">
                                                @foreach (var v in variants)
                                                {
                                                    <code class="small text-break">@v</code>
                                                }
                                            </div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <hr class="my-4" />

    @* ───────── Municipality Graph ───────── *@
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Municipality Graph — k-Nearest Neighbors</h5>
        </div>
        <div class="card-body">
            <p class="text-body-secondary small mb-2">
                All 290 Swedish municipalities positioned by their
                <a href="https://www.wikidata.org/wiki/Property:P625" target="_blank" rel="noopener">Wikidata coordinates</a>,
                connected to their <em>k</em> geographically nearest neighbors.
                Hover a node to see its connections, or click a county in the legend to filter.
            </p>
            <div id="municipality-graph-container"></div>

            <hr class="my-3" />

            <h6 class="mb-2">Neighbor Search — <code>FindNeighbors(radiusKm)</code></h6>
            <p class="text-body-secondary small mb-2">
                Select a municipality and radius to find all neighbors within that distance.
                Results are computed using the Haversine formula and highlighted on the graph above.
            </p>
            <div class="row g-2 align-items-end mb-3">
                <div class="col-auto" style="min-width:200px">
                    <label class="form-label small mb-1">Municipality</label>
                    <select class="form-select form-select-sm" @bind="neighborSearchMuni" @bind:after="RunNeighborSearch">
                        @foreach (var m in SwedishMunicipality.All)
                        {
                            <option value="@m.Code">@m.LocalizedName</option>
                        }
                    </select>
                </div>
                <div class="col-auto" style="width:140px">
                    <label class="form-label small mb-1">Radius (km)</label>
                    <input type="number" class="form-control form-control-sm" min="1" max="2000" step="10"
                           @bind="neighborSearchRadius" @bind:event="oninput" @bind:after="RunNeighborSearch" />
                </div>
                <div class="col-auto">
                    <span class="badge bg-primary">@(neighborResults?.Count ?? 0) found</span>
                </div>
            </div>

            @if (neighborResults is { Count: > 0 })
            {
                <div class="table-responsive" style="max-height:300px;overflow-y:auto">
                    <table class="table table-sm table-hover align-middle mb-0" style="font-size:.82rem">
                        <thead class="table-light sticky-top">
                            <tr>
                                <th style="width:40px">#</th>
                                <th>Municipality</th>
                                <th>County</th>
                                <th class="text-end">Distance</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ var rank = 0; }
                            @foreach (var n in neighborResults)
                            {
                                rank++;
                                <tr>
                                    <td class="text-body-secondary">@rank</td>
                                    <td class="fw-medium">@n.Municipality.LocalizedName <code class="text-body-tertiary ms-1">@n.Municipality.Code</code></td>
                                    <td class="text-body-secondary">@n.Municipality.County.LocalizedName</td>
                                    <td class="text-end font-monospace">@n.Distance.Kilometers.ToString("N1") km</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    @* ───────── County Graph ───────── *@
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">County Graph — Adjacency</h5>
        </div>
        <div class="card-body">
            <p class="text-body-secondary small mb-2">
                All 21 Swedish counties positioned by their
                <a href="https://www.wikidata.org/wiki/Property:P625" target="_blank" rel="noopener">Wikidata coordinates</a>,
                connected by actual land borders (derived from municipality-level SCB boundary data).
                Hover a node to see adjacent counties and municipalities.
            </p>
            <div id="county-graph-container"></div>
        </div>
    </div>

    @* ───────── Country Graph ───────── *@
    <div class="card mb-4">
        <div class="card-header">
            <h5 class="mb-0">Country Graph — Land Borders</h5>
        </div>
        <div class="card-body">
            <p class="text-body-secondary small mb-2">
                Countries positioned by their
                <a href="https://www.wikidata.org/wiki/Property:P625" target="_blank" rel="noopener">Wikidata coordinates</a>,
                connected by shared land borders (sourced from
                <a href="https://www.wikidata.org/wiki/Property:P47" target="_blank" rel="noopener">Wikidata P47</a>).
                Filter by continent, hover a node to see neighbors and capital city.
            </p>
            <div id="country-graph-container"></div>
        </div>
    </div>

</div>

@code {

    // ── Text Scanner state ─────────────────────────────────────────

    private string inputText = "";
    private string displayMode = "label";
    private TextMatchConfidence minimumConfidence = TextMatchConfidence.Medium;
    private TextScanResult? scanResult;
    private string? scannedText;
    private readonly TextScanner scanner = new();

    private void SetModeLabel() => displayMode = "label";
    private void SetModeMask() => displayMode = "mask";
    private void SetModeRedact() => displayMode = "redact";
    private void SetModeLookup() => displayMode = "lookup";

    private void LoadExample(string text)
    {
        inputText = text;
        Scan();
    }

    private void Scan()
    {
        if (string.IsNullOrWhiteSpace(inputText))
        {
            scanResult = null;
            scannedText = null;
            return;
        }
        var options = new TextScannerOptions { MinimumConfidence = minimumConfidence };
        scanResult = scanner.Scan(inputText, options);
        scannedText = inputText;
    }

    // ── Label-mode HTML builder ────────────────────────────────────

    private MarkupString BuildLabeledHtml()
    {
        if (scanResult == null || scannedText == null) return new MarkupString("");

        var sb = new StringBuilder();
        var lastEnd = 0;

        foreach (var c in scanResult.ResolvedCandidates)
        {
            if (c.StartIndex > lastEnd)
                AppendEncoded(sb, scannedText[lastEnd..c.StartIndex]);

            var css = GetCategoryClass(c.Category);
            var catBadge = GetCategoryBadgeClass(c.Category);
            var confBadge = GetConfidenceBadge(c.Confidence);

            sb.Append($"<span class=\"scan-tip-wrap\">");
            sb.Append($"<mark class=\"scan-match {css}\">");
            sb.Append(WebUtility.HtmlEncode(scannedText[c.StartIndex..c.EndIndex]));
            sb.Append("</mark>");

            sb.Append("<span class=\"scan-tip\">");
            sb.Append($"<div class=\"fw-bold mb-1\">{WebUtility.HtmlEncode(c.TypeName)}</div>");
            sb.Append($"<div class=\"mb-2\"><span class=\"badge {catBadge} me-1\">{c.Category}</span>");
            sb.Append($"<span class=\"badge {confBadge}\">{c.Confidence}</span></div>");
            sb.Append($"<div class=\"scan-tip-row\"><span class=\"scan-tip-label\">Formatted</span><span class=\"scan-tip-value\">{WebUtility.HtmlEncode(c.FormattedForm)}</span></div>");
            sb.Append($"<div class=\"scan-tip-row\"><span class=\"scan-tip-label\">Normalized</span><span class=\"scan-tip-value\">{WebUtility.HtmlEncode(c.NormalizedForm)}</span></div>");
            sb.Append($"<div class=\"scan-tip-row\"><span class=\"scan-tip-label\">Masked</span><span class=\"scan-tip-value\">{WebUtility.HtmlEncode(c.MaskedForm)}</span></div>");
            sb.Append("</span></span>");

            lastEnd = c.EndIndex;
        }

        if (lastEnd < scannedText.Length)
            AppendEncoded(sb, scannedText[lastEnd..]);

        return new MarkupString(sb.ToString());
    }

    private static void AppendEncoded(StringBuilder sb, string text) =>
        sb.Append(WebUtility.HtmlEncode(text).Replace("\n", "<br />"));

    // ── Lookup-mode HTML builder ────────────────────────────────────

    private static readonly Regex MarkdownLinkPattern = new(
        @"\[([^\]]+)\]\(([^)]+)\)", RegexOptions.Compiled);

    private MarkupString BuildLookupHtml()
    {
        if (scanResult == null || scannedText == null) return new MarkupString("");

        var markdown = scanResult.ReplaceAll(scannedText, c =>
        {
            var url = GetLookupUrl(c);
            return url != null ? $"[{c.OriginalText}]({url})" : c.OriginalText;
        });

        var encoded = WebUtility.HtmlEncode(markdown).Replace("\n", "<br />");
        var html = MarkdownLinkPattern.Replace(encoded,
            "<a href=\"$2\" target=\"_blank\" rel=\"noopener\" class=\"scan-lookup\">$1</a>");
        return new MarkupString(html);
    }

    private static string? GetLookupUrl(TextCandidate c) => c switch
    {
        TextCandidate<SwedishOrganizationNumber> x => x.Value.ToAllabolagUrl(),
        TextCandidate<EuVatNumber> x => x.Value.ToViesUrl(),
        TextCandidate<LeiCode> x => x.Value.ToGleifUrl(),
        TextCandidate<EmailAddress> x => x.Value.ToMailtoUri(),
        TextCandidate<PhoneNumber> x => x.Value.ToTelUri(),
        TextCandidate<Url> x => x.Value.ToNormalizedUrl(),
        TextCandidate<Address> x => x.Value.ToGoogleMapsUrl(),
        TextCandidate<SwedishAddress> x => x.Value.ToGoogleMapsUrl(),
        TextCandidate<Country> x => x.Value.ToWikipediaUrl(),
        TextCandidate<SwedishVehicleRegistrationNumber> x => x.Value.ToBiluppgifterUrl(),
        TextCandidate<SwedishPropertyDesignation> x => x.Value.ToHittaUrl(),
        TextCandidate<Gtin13> x => x.Value.ToBarcodeLookupUrl(),
        TextCandidate<Gtin8> x => x.Value.ToBarcodeLookupUrl(),
        TextCandidate<SwedishMunicipality> x => x.Value.ToWikipediaUrl(),
        TextCandidate<SwedishCounty> x => x.Value.ToWikipediaUrl(),
        _ => null
    };

    // ── Category / confidence helpers ──────────────────────────────

    private static string GetCategoryClass(TextCandidateCategory cat) => cat switch
    {
        TextCandidateCategory.PersonalIdentifier => "cat-personal",
        TextCandidateCategory.OrganizationIdentifier => "cat-org",
        TextCandidateCategory.Financial => "cat-financial",
        TextCandidateCategory.Contact => "cat-contact",
        TextCandidateCategory.Vehicle => "cat-vehicle",
        TextCandidateCategory.Property => "cat-property",
        TextCandidateCategory.Product => "cat-product",
        TextCandidateCategory.Geography => "cat-geography",
        TextCandidateCategory.Measurement => "cat-measurement",
        _ => ""
    };

    private static string GetCategoryBadgeClass(TextCandidateCategory cat) => cat switch
    {
        TextCandidateCategory.PersonalIdentifier => "bg-danger",
        TextCandidateCategory.OrganizationIdentifier => "bg-primary",
        TextCandidateCategory.Financial => "bg-success",
        TextCandidateCategory.Contact => "bg-info text-dark",
        TextCandidateCategory.Vehicle => "bg-warning text-dark",
        TextCandidateCategory.Property => "bg-secondary",
        TextCandidateCategory.Product => "bg-dark",
        TextCandidateCategory.Geography => "bg-success-subtle text-success-emphasis",
        TextCandidateCategory.Measurement => "bg-warning-subtle text-warning-emphasis",
        _ => "bg-light text-dark"
    };

    private static string GetConfidenceBadge(TextMatchConfidence conf) => conf switch
    {
        TextMatchConfidence.High => "bg-success",
        TextMatchConfidence.Medium => "bg-warning text-dark",
        TextMatchConfidence.Low => "bg-secondary",
        _ => "bg-light text-dark"
    };

    // ── Example texts ──────────────────────────────────────────────

    private static readonly (string Name, string Text)[] SampleTexts =
    [
        ("Swedish Companies",
            "Telefonaktiebolaget LM Ericsson (org.nr 556016-0680) is one of Sweden's largest " +
            "technology companies, headquartered at Torshamnsgatan 21, 164 83 Stockholm. " +
            "Their VAT number is SE556016068001. For press inquiries, contact press@example.com " +
