    // ── Municipality Graph ──────────────────────────────────────────

    private bool graphInitialized;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !graphInitialized)
        {
            graphInitialized = true;

            var nodesJson = JsonSerializer.Serialize(
                SwedishMunicipality.All.Select(m => new
                {
                    code = m.Code,
                    name = m.LocalizedName,
                    lat = m.Latitude,
                    lon = m.Longitude,
                    county = m.CountyCode
                }));

            var countiesJson = JsonSerializer.Serialize(
                SwedishMunicipality.All
                    .Select(m => m.County)
                    .DistinctBy(c => c.Code)
                    .ToDictionary(
                        c => c.Code,
                        c => new { name = c.LocalizedName, color = CountyColors.GetValueOrDefault(c.Code, "#6c757d") }));

            await JS.InvokeVoidAsync("municipalityGraph.init",
                "municipality-graph-container", nodesJson, countiesJson);

            var allCounties = SwedishMunicipality.All
                .Select(m => m.County)
                .DistinctBy(c => c.Code)
                .OrderBy(c => c.Code)
                .ToList();

            var countyNodesJson = JsonSerializer.Serialize(
                allCounties.Select(c => new
                {
                    code = c.Code,
                    name = c.LocalizedName,
                    lat = c.Latitude,
                    lon = c.Longitude,
                    color = CountyColors.GetValueOrDefault(c.Code, "#6c757d"),
                    muniCount = c.GetMunicipalities().Count,
                    municipalities = string.Join(", ", c.GetMunicipalities().Select(m => m.LocalizedName))
                }));

            var countyAdjacencyJson = JsonSerializer.Serialize(
                allCounties.ToDictionary(
                    c => c.Code,
                    c => c.GetAdjacentCounties().Select(a => a.Code).ToArray()));

            await JS.InvokeVoidAsync("countyGraph.init",
                "county-graph-container", countyNodesJson, countyAdjacencyJson);

            var countryNodesJson = JsonSerializer.Serialize(
                Country.All
                    .Where(c => c.Coordinate.Latitude != 0 || c.Coordinate.Longitude != 0)
                    .Select(c => new
                    {
                        code = c.Alpha2Code,
                        name = c.EnglishName,
                        lat = c.Latitude,
                        lon = c.Longitude,
                        continent = c.Continent.EnglishName,
                        capital = c.Capital?.EnglishName,
                        capitalNative = c.Capital?.NativeName
                    }));

            var countryAdjacencyJson = JsonSerializer.Serialize(
                Country.All.ToDictionary(
                    c => c.Alpha2Code,
                    c => c.GetBorderingCountries().Select(b => b.Alpha2Code).ToArray()));

            var continentColorsJson = JsonSerializer.Serialize(ContinentColors);

            await JS.InvokeVoidAsync("countryGraph.init",
                "country-graph-container", countryNodesJson, countryAdjacencyJson, continentColorsJson);
        }
    }

    // ── Neighbor Search ───────────────────────────────────────────

    private string neighborSearchMuni = "0180";
    private int neighborSearchRadius = 50;
    private IReadOnlyList<MunicipalityDistance>? neighborResults;

    private async Task RunNeighborSearch()
    {
        if (!SwedishMunicipality.TryParse(neighborSearchMuni, out var muni) || neighborSearchRadius < 1)
        {
            neighborResults = null;
            return;
        }

        neighborResults = muni!.FindNeighbors(neighborSearchRadius);

        var codes = neighborResults.Select(n => n.Municipality.Code).ToList();
        codes.Insert(0, muni.Code);
        await JS.InvokeVoidAsync("municipalityGraph.highlightCodes", codes.ToArray());
    }

